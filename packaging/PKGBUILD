# Maintainer: Roddy Salardon
# AUR-style recipe. Runtime Python deps not in [extra] (ddgs) are vendored via pip at build time
# by install.sh instead; this PKGBUILD documents the system dependencies.
pkgname=gamebuddy-git
pkgver=0.6.0
pkgrel=1
pkgdesc="Voice-first AI gaming companion for Linux (Wayland/Hyprland/Omarchy)"
arch=('any')
url="https://github.com/Roddygithub/gamebuddy"
license=('MIT')
depends=('python>=3.11' 'pyside6' 'python-numpy' 'python-sounddevice' 'python-openai' 'python-anthropic'
         'python-httpx' 'python-pillow' 'python-tomli-w' 'grim' 'portaudio')
optdepends=('espeak-ng: offline text-to-speech'
            'piper-tts: neural offline text-to-speech'
            'wmctrl: window list on X11'
            'imagemagick: X11 screenshots'
            'hyprland: window list and overlay rules')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() { cd gamebuddy && git describe --tags --long 2>/dev/null | sed 's/^v//;s/-/.r/;s/-/./' || echo 0.6.0.r0; }

build() {
  cd gamebuddy
  python -m build --wheel --no-isolation
}

package() {
  cd gamebuddy
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/gamebuddy/assets/gamebuddy-symbolic.svg "$pkgdir/usr/share/icons/hicolor/scalable/status/gamebuddy-symbolic.svg"
  sed 's|@BIN@|/usr/bin/gamebuddy|' packaging/gamebuddy.desktop > gamebuddy.desktop
  install -Dm644 gamebuddy.desktop "$pkgdir/usr/share/applications/gamebuddy.desktop"
  sed 's|@BIN@|/usr/bin/gamebuddy|' packaging/gamebuddy.service > gamebuddy.service
  install -Dm644 gamebuddy.service "$pkgdir/usr/lib/systemd/user/gamebuddy.service"
}
